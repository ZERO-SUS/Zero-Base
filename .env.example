# ============================================================
# ZERO BASE — Environment Variables Template
# Copy to .env (frontend) and worker/.dev.vars (local Worker)
# NEVER commit real secrets to Git!
# ============================================================

# --- Frontend (Vite / Cloudflare Pages public env vars) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_APP_NAME=ZERO BASE

# --- Worker Backend (worker/.dev.vars for local, Cloudflare Secrets for prod) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: used if HS256 JWT verification is configured instead of JWKS
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-if-hs256
# Random 64-char hex secret for signing short-lived R2 download URLs
FILE_SIGNING_SECRET=replace-with-64-char-random-hex-secret
# Comma-separated allowed CORS origins (Pages URL + local dev)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev
ENVIRONMENT=development

# --- Backup Scripts Only (NEVER put in browser or Worker runtime) ---
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-s3-api-access-key
R2_SECRET_ACCESS_KEY=your-r2-s3-api-secret-key
R2_BUCKET_NAME=zero-base-files
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
