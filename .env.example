# ============================================================
# ZERO BASE — Environment Variables Template
# Copy to .env (frontend) and worker/.dev.vars (local Worker)
# NEVER commit real secrets or tokens to Git!
# ============================================================

# --- Frontend (Vite / Cloudflare Pages public env vars) ---
VITE_SUPABASE_URL=https://fskcdtpdkjgjaksqwjaf.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_APP_NAME=ZERO BASE

# --- Worker Backend (worker/.dev.vars for local, Cloudflare Secrets for prod) ---
SUPABASE_URL=https://fskcdtpdkjgjaksqwjaf.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
# Comma-separated 3 Supabase Auth UUIDs belonging to the owner
OWNER_USER_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002,00000000-0000-0000-0000-000000000003
STORAGE_BUCKET=zero-base-files
ALLOWED_ORIGINS=http://localhost:5173,https://zero-base.pages.dev
# Optional if HS256 JWT verification is used instead of JWKS
SUPABASE_JWT_SECRET=
ENVIRONMENT=development

# --- Free-Plan Backup Scripts Only (NEVER put in browser or Worker runtime) ---
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.fskcdtpdkjgjaksqwjaf.supabase.co:5432/postgres
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Optional for scripts/backup-storage.mjs (an authorized owner email & password, or active JWT)
BACKUP_OWNER_EMAIL=
BACKUP_OWNER_PASSWORD=
